{
  "name": "kalit-extension",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Kalit — hardware password manager uchun Chrome extension (MV3)",
  "scripts": {
    "dev": "concurrently -k -n app,content \"vite build --watch --mode development\" \"vite build -c vite.content.config.ts --watch --mode development\"",
    "build": "npm run clean && tsc --noEmit && vite build && vite build -c vite.content.config.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "cborg": "^7.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esptool-js": "^0.7.1",
    "lucide-react": "^0.544.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "react-router": "^7.9.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tldts": "^7.0.16",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/chrome": "^0.1.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.1.1"
  }
}
